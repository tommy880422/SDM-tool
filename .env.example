# 把這個檔案複製成 .env.local，填入你自己 Firebase 專案的值。
# 取得方式：Firebase 主控台 → 專案設定 → 一般 → 你的應用程式（網頁）→ SDK 設定。
# .env.local 不會被 git 追蹤。
#
# Copy this file to .env.local and fill in your own Firebase project's values.
# Where to find them: Firebase console → Project settings → General → Your apps (web) → SDK setup and configuration.
# .env.local is not tracked by git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# 選填（Google Analytics）/ Optional (Google Analytics)
VITE_FIREBASE_MEASUREMENT_ID=
